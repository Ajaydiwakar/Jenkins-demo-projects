pipeline {
    agent any

    environment {
        NETWORK = 'jenkins-net'
        BACKEND_IMAGE = 'polyglot-backend:latest'
        FRONTEND_IMAGE = 'polyglot-frontend:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test Backend (Java)') {
            steps {
                dir('backend') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('Build & Test Frontend (Python)') {
            steps {
                dir('frontend') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install -r requirements.txt
                        PYTHONPATH=. pytest tests/
                    '''
                }
            }
        }

        stage('SonarQube Monorepo Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    // Scanning the entire monorepo based on sonar-project.properties at the root
                    sh 'sonar-scanner'
                }
            }
        }

        stage('Docker Build (Multiple Images)') {
            steps {
                // Build Backend
                dir('backend') {
                    sh "docker build -t ${BACKEND_IMAGE} ."
                }
                // Build Frontend
                dir('frontend') {
                    sh "docker build -t ${FRONTEND_IMAGE} ."
                }
            }
        }

        stage('Trivy Image Scans') {
            steps {
                // Scan both images
                sh "trivy image --exit-code 1 --severity HIGH,CRITICAL ${BACKEND_IMAGE}"
                sh "trivy image --exit-code 1 --severity HIGH,CRITICAL ${FRONTEND_IMAGE}"
            }
        }

        stage('Deploy to Local Network') {
            steps {
                script {
                    // Cleanup old containers
                    sh "docker rm -f backend-container frontend-container || true"
                    
                    // Deploy Backend
                    sh """
                        docker run -d \
                          --name backend-container \
                          --network ${NETWORK} \
                          -p 8080:8080 \
                          ${BACKEND_IMAGE}
                    """
                    
                    // Deploy Frontend and link it to the backend container via Env Var
                    sh """
                        docker run -d \
                          --name frontend-container \
                          --network ${NETWORK} \
                          -p 5000:5000 \
                          -e BACKEND_URL=http://backend-container:8080 \
                          ${FRONTEND_IMAGE}
                    """
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline execution complete.'
            sh 'docker image prune -f'
        }
        success {
            echo "Successfully deployed Monorepo!"
            echo "Frontend UI: http://localhost:5000"
            echo "Backend API: http://localhost:8080/api/data"
        }
    }
}
