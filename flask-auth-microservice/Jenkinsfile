pipeline {
    agent any

    environment {
        APP_NAME = 'flask-auth-microservice'
        IMAGE_TAG = "latest"
        NETWORK = 'jenkins-net'
        PORT = '5000'
        // Ensure this credential exists in Jenkins -> Manage Credentials
        AUTH_SECRET = credentials('demo-auth-secret') 
    }

    stages {
        stage('Checkout') {
            steps {
                // Checks out the entire Ajaydiwakar/Jenkins-demo-projects repo
                checkout scm
            }
        }

        stage('Python Build & Test') {
            steps {
                // Navigate into the project folder before running pip
                dir('flask-auth-microservice') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install -r requirements.txt
                        pytest tests/
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('flask-auth-microservice') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'sonar-scanner'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('flask-auth-microservice') {
                    sh "docker build -t ${APP_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                // Trivy scans the compiled image, so it doesn't strictly need the dir() block, 
                // but keeping it here maintains consistency.
                dir('flask-auth-microservice') {
                    sh "trivy image --exit-code 1 --severity HIGH,CRITICAL ${APP_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to Local Network') {
            steps {
                dir('flask-auth-microservice') {
                    script {
                        sh "docker rm -f ${APP_NAME}-container || true"
                        
                        sh """
                            docker run -d \
                              --name ${APP_NAME}-container \
                              --network ${NETWORK} \
                              -p ${PORT}:${PORT} \
                              -e AUTH_SECRET=${AUTH_SECRET} \
                              ${APP_NAME}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline execution complete.'
            sh 'docker image prune -f'
        }
        success {
            echo "Successfully deployed to http://localhost:${PORT}/auth"
        }
    }
}
