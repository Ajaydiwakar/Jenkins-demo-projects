pipeline {
    agent {
        label 'docker-worker-1'
    }

    environment {
        SONAR_HOST_URL = 'http://sonarqube:9000'
        SONAR_TOKEN    = credentials('sonar-token')
        IMAGE_NAME     = 'flask-auth-microservice'
        IMAGE_TAG      = "${BUILD_NUMBER}"
        APP_PORT       = '5000'
        AUTH_SECRET    = credentials('demo-auth-secret')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Compile & Test') {
            steps {
                dir('flask-auth-microservice') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --no-cache-dir -r requirements.txt
                        PYTHONPATH=. pytest tests/
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'flask-auth-microservice/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('flask-auth-microservice') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            sonar-scanner \
                              -Dsonar.projectKey=flask-auth-microservice \
                              -Dsonar.projectName="Flask Auth Microservice" \
                              -Dsonar.sources=. \
                              -Dsonar.exclusions=**/tests/**,**/venv/** \
                              -Dsonar.host.url=${SONAR_HOST_URL} \
                              -Dsonar.token=${SONAR_TOKEN}
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('flask-auth-microservice') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest"
                }
            }
        }

        stage('Trivy Image Vulnerability Scan') {
            steps {
                sh """
                    trivy image --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      --format table \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy Container') {
            steps {
                sh """
                    echo "=== Available Docker Networks ==="
                    docker network ls

                    # Create network on this daemon if missing
                    docker network inspect jenkins-net >/dev/null 2>&1 || docker network create jenkins-net

                    docker stop ${IMAGE_NAME}-container || true
                    docker rm ${IMAGE_NAME}-container || true
                    docker run -d \
                      --name ${IMAGE_NAME}-container \
                      --network jenkins-net \
                      -p ${APP_PORT}:${APP_PORT} \
                      -e AUTH_SECRET=${AUTH_SECRET} \
                      ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo "Application successfully deployed! Accessible at http://localhost:${APP_PORT}/auth"
        }
        failure {
            echo "Pipeline failed. Deployment aborted."
        }
    }
}
