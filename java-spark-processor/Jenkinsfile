pipeline {
    agent any

    environment {
        APP_NAME = 'java-data-processor'
        IMAGE_TAG = "latest"
        NETWORK = 'jenkins-net'
        // Define local Maven repo to cache heavy dependencies
        MAVEN_REPO = "${WORKSPACE}/.m2/repository"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build & Test (Cached)') {
            steps {
                // The -Dmaven.repo.local flag ensures downloaded artifacts stay in the workspace cache
                sh 'mvn -Dmaven.repo.local=${MAVEN_REPO} clean install'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn -Dmaven.repo.local=${MAVEN_REPO} sonar:sonar'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t ${APP_NAME}:${IMAGE_TAG} ."
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh "trivy image --exit-code 1 --severity HIGH,CRITICAL ${APP_NAME}:${IMAGE_TAG}"
            }
        }

        stage('Deploy to Local Network') {
            steps {
                script {
                    sh "docker rm -f ${APP_NAME}-container || true"
                    
                    sh """
                        docker run -d \
                          --name ${APP_NAME}-container \
                          --network ${NETWORK} \
                          ${APP_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline execution complete.'
            sh 'docker image prune -f'
        }
        success {
            echo "Successfully deployed ${APP_NAME}. Check logs with: docker logs ${APP_NAME}-container"
        }
    }
}